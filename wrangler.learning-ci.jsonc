{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buildscope-learning-ci",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/learn/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [{"binding":"LEARNING_DB","database_name":"buildscope-learning-ci","database_id":"00000000-0000-4000-8000-000000000009"}],
  "r2_buckets": [{"binding":"LEARNING_MEDIA","bucket_name":"buildscope-learning-ci"}],
  "vars": {"CMS_ORIGIN":"http://127.0.0.1:8787","GITHUB_REPOSITORY":"Buildscope365/buildscope-blog"}
}
