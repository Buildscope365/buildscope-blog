{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buildscope-learning-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/admin*", "/auth*", "/callback*", "/api/instagram*", "/api/learn/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [{"binding":"LEARNING_DB","database_name":"buildscope-learning-test","database_id":"REPLACE_WITH_TEST_D1_ID"}],
  "r2_buckets": [{"binding":"LEARNING_MEDIA","bucket_name":"buildscope-learning-media-test"}],
  "vars": {
    "CMS_ORIGIN": "https://buildscope-blog.com",
    "GITHUB_REPOSITORY": "Buildscope365/buildscope-blog",
    "IG_GRAPH_VERSION": "v24.0"
  }
}
