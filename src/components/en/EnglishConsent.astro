<section class="en-consent" data-en-consent role="dialog" aria-label="Analytics preferences" hidden><p>We use optional analytics cookies to understand how our resources are used. No analytics are loaded until you agree.</p><div><button type="button" data-en-deny>Essential only</button><button type="button" data-en-accept>Accept analytics</button></div></section><button class="en-preferences" type="button" data-en-preferences hidden>Cookie settings</button>
<style>.en-consent{position:fixed;bottom:16px;left:16px;right:16px;z-index:1000;max-width:850px;margin:auto;background:#10233b;color:white;box-shadow:0 14px 45px #0005;padding:20px;display:flex;align-items:center;gap:20px}.en-consent[hidden],.en-preferences[hidden]{display:none}.en-consent p{margin:0;flex:1}.en-consent div{display:flex;gap:8px}.en-consent button,.en-preferences{font:inherit;min-height:44px;padding:8px 12px;cursor:pointer}.en-consent [data-en-accept]{background:#eac14f;border:1px solid #eac14f}.en-consent [data-en-deny]{background:transparent;color:white;border:1px solid white}.en-preferences{position:fixed;bottom:12px;left:12px;z-index:999;background:white;border:1px solid #10233b}@media(max-width:650px){.en-consent{flex-direction:column;align-items:start}.en-consent div{flex-wrap:wrap}}</style>
<script>import {initializeAnalytics} from '../../scripts/conversionTracking';initializeAnalytics();const banner=document.querySelector<HTMLElement>('[data-en-consent]');const pref=document.querySelector<HTMLButtonElement>('[data-en-preferences]');const chosen=(()=>{try{return localStorage.getItem('buildscope_analytics_consent')}catch{return null}})();if(banner)banner.hidden=chosen==='granted'||chosen==='denied';if(pref)pref.hidden=!chosen;const set=(status:'granted'|'denied')=>{window.BuildScopeAnalytics?.setConsent(status);if(banner)banner.hidden=true;if(pref)pref.hidden=false};document.querySelector('[data-en-accept]')?.addEventListener('click',()=>set('granted'));document.querySelector('[data-en-deny]')?.addEventListener('click',()=>set('denied'));pref?.addEventListener('click',()=>{if(banner)banner.hidden=false;pref.hidden=true});</script>
