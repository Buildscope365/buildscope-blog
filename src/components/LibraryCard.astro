---
import type { LibraryItem } from "../data/library";
interface Props { item: LibraryItem; }
const { item } = Astro.props;
---
<article class="library-card">
  <a href={`/library/${item.categorySlug}/${item.slug}/`} aria-label={`閱讀 ${item.title}`}>
    <div class="library-card-image"><img src={item.slides[0].src} alt={item.slides[0].alt} width="1080" height="1350" loading="lazy" /><span>{String(item.slides.length).padStart(2, "0")} SLIDES</span></div>
    <div class="library-card-copy"><p>{item.category.toUpperCase()} × QS</p><h2>{item.title}</h2><div>{item.introduction}</div><strong>閱讀完整 Carousel →</strong></div>
  </a>
</article>
<style>
  .library-card { overflow: hidden; border: 1px solid var(--line); background: white; transition: transform .2s ease, border-color .2s ease; }
  .library-card:hover { transform: translateY(-4px); border-color: var(--orange); }
  .library-card-image { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: #082544; }
  .library-card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .library-card:hover img { transform: scale(1.02); }
  .library-card-image span { position: absolute; right: 14px; bottom: 14px; padding: 7px 10px; border-radius: 4px; color: white; background: rgba(17,17,17,.82); font-size: .7rem; font-weight: 900; letter-spacing: .1em; }
  .library-card-copy { padding: 24px; }
  .library-card-copy p { margin: 0; color: var(--orange-dark); font-size: .74rem; font-weight: 900; letter-spacing: .12em; }
  .library-card-copy h2 { margin: 13px 0 10px; font-size: 1.55rem; line-height: 1.25; letter-spacing: -.04em; }
  .library-card-copy div { color: var(--body); font-size: .92rem; }
  .library-card-copy strong { display: inline-block; margin-top: 20px; font-size: .84rem; }
</style>
