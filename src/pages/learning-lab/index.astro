---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LearningLabCTA from "../../components/LearningLabCTA.astro";
import { courseCategories, getPublishedCourses } from "../../data/courses";
import "../../styles/learning-lab.css";
const courses = await getPublishedCourses();
const categories = Object.entries(courseCategories).filter(([key]) => courses.some((course) => course.data.category === key));
---
<BaseLayout title="Learning Lab 課程目錄｜工程白話文 BuildScope" description="探索 NEC4、AI × Microsoft 365、PNRC 及 Dewatering 工程課程。先免費閱讀 Lesson Preview，再到 Skool BuildScope Learning Lab 體驗 7 天。" jsonLd={{"@context":"https://schema.org","@type":"CollectionPage",name:"BuildScope Learning Lab 課程目錄",url:"https://buildscope-blog.com/learning-lab/"}}>
  <div class="learning-lab"><header class="lab-hero"><div class="lab-shell"><h1>工程知識，<br /><span>由預覽開始。</span></h1><p>探索 BuildScope Learning Lab 課程，免費讀一篇 Lesson Preview，再決定點樣深入學習。</p></div></header>
    <div class="lab-shell lab-main"><p class="lab-intro">網站提供課程簡介及公開預覽；想深入探索，可以到 Skool 體驗 BuildScope Learning Lab 7 天。實際可瀏覽內容以 Skool 顯示為準。</p>
      <div class="lab-controls"><label for="lab-search">搜尋課程<input id="lab-search" type="search" autocomplete="off" placeholder="例如 NEC4、PNRC、AI" /></label><div class="lab-filters" role="group" aria-label="課程分類"><button type="button" data-category="all" aria-pressed="true">全部</button>{categories.map(([key,label])=><button type="button" data-category={key} aria-pressed="false">{label}</button>)}</div></div>
      <p role="status" aria-live="polite" data-results>顯示 {courses.length} 個課程</p>
      <div class="lab-list">{courses.map((course)=><article class="lab-card" data-course data-category={course.data.category} data-search={`${course.data.title} ${course.data.description} ${course.data.audience} ${courseCategories[course.data.category]}`}><small>{courseCategories[course.data.category]}</small><h2>{course.data.title}</h2><p>{course.data.description}</p><a href={`/learning-lab/${course.id}/`}>查看課程及免費預覽 →</a></article>)}</div>
      <p class="lab-empty" data-empty hidden>暫時搵唔到課程。試下其他關鍵字或分類。</p>
      <LearningLabCTA location="learning_lab_catalog" />
    </div>
  </div>
</BaseLayout>
<script>
  import { trackConversionEvent } from "../../scripts/conversionTracking";
  const search = document.querySelector<HTMLInputElement>("#lab-search");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-category]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-course]")];
  const results = document.querySelector<HTMLElement>("[data-results]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const params = new URLSearchParams(location.search);
  let category = buttons.some((b) => b.dataset.category === params.get("category")) ? params.get("category")! : "all";
  if (search) search.value = params.get("q") ?? "";
  function update(type?: "text" | "category") {
    const terms = (search?.value ?? "").normalize("NFKC").toLocaleLowerCase("zh-HK").trim().split(/\s+/).filter(Boolean);
    let visible = 0;
    cards.forEach((card) => { card.hidden = !(category === "all" || card.dataset.category === category) || !terms.every((term) => (card.dataset.search ?? "").normalize("NFKC").toLocaleLowerCase("zh-HK").includes(term)); if (!card.hidden) visible++; });
    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.category === category)));
    if (results) results.textContent = `顯示 ${visible} 個課程`;
    if (empty) empty.hidden = visible > 0;
    const url = new URL(location.href);
    terms.length ? url.searchParams.set("q", search!.value.trim()) : url.searchParams.delete("q");
    category === "all" ? url.searchParams.delete("category") : url.searchParams.set("category", category);
    history.replaceState(null, "", url);
    if (type) trackConversionEvent("learning_lab_search", { search_type: type, search_term_length: type === "text" ? search!.value.trim().length : undefined, selected_category: category, result_count: visible });
  }
  search?.addEventListener("input", () => update("text"));
  buttons.forEach((button) => button.addEventListener("click", () => { category = button.dataset.category ?? "all"; update("category"); }));
  update();
</script>
