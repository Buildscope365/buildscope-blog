---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const guides = (await getCollection("pocketGuides", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout
  title="Pocket Guide｜工程白話文 BuildScope"
  description="BuildScope Pocket Guide：按工程實務主題整理的隨身指南。瀏覽 EOT 工期延長指南及更多後續主題。"
>
  <header class="guide-hero">
    <div class="container hero-inner">
      <div>
        <p class="eyebrow">BUILDSCOPE · PRACTICAL RESOURCES</p>
        <h1>Pocket <span>Guide</span></h1>
        <p class="hero-intro">工程實務，整理成隨手可查的指南。</p>
      </div>
      <div class="hero-mark" aria-hidden="true">PG</div>
    </div>
  </header>

  <section class="guide-section" aria-labelledby="guides-heading">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">GUIDE COLLECTION</p><h2 id="guides-heading">揀一個主題，深入睇。</h2></div>
        <p>由 BuildScope 整理的工程實務主題。</p>
      </div>
      <div class="guide-grid">
        {guides.map((guide) => (
          <article class="guide-card">
            {guide.data.coverImage ? (
              <img class="guide-cover" src={guide.data.coverImage} alt={`${guide.data.title} 封面`} loading="lazy" />
            ) : (
              <div class="guide-cover guide-cover--graphic" aria-hidden="true">
                <small>BUILDSCOPE / POCKET GUIDE</small>
                <strong>{guide.data.title}</strong>
                <span>{guide.data.topic}</span>
              </div>
            )}
            <div class="guide-copy">
              <p class="guide-topic">{guide.data.topic}</p>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
              <a href={guide.data.downloadUrl ?? guide.data.purchaseUrl} target="_blank" rel="noopener noreferrer" aria-label={`${guide.data.actionLabel ?? "查看指南"}：${guide.data.title}${guide.data.downloadUrl ? "，開啟 PDF" : "，前往 Gumroad"}`}>{guide.data.actionLabel ?? "查看指南"}</a>
              <small>{guide.data.actionNote ?? "連結會開啟 Gumroad 產品頁面"}</small>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow{margin:0;color:var(--orange);font-size:.82rem;font-weight:900;letter-spacing:.12em}.guide-hero{padding:clamp(60px,9vw,110px) 0;color:white;background:#0a1931}.hero-inner{display:flex;align-items:center;justify-content:space-between;gap:36px}.guide-hero .eyebrow{color:#ffc107}.guide-hero h1{margin:16px 0;font-size:clamp(3.4rem,8vw,7.5rem);line-height:1;letter-spacing:-.07em}.guide-hero h1 span{color:#ffc107}.hero-intro{margin:0;color:#d5dfec;font-size:clamp(1rem,2vw,1.25rem)}.hero-mark{display:grid;flex:0 0 auto;width:154px;height:192px;place-items:center;border:2px solid #ffc107;color:#ffc107;font-size:3.2rem;font-weight:900;transform:rotate(7deg)}.guide-section{padding:clamp(64px,8vw,100px) 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:32px}.section-heading h2{margin:10px 0 0;font-size:clamp(2rem,4vw,3.5rem);line-height:1.12}.section-heading>p{margin:0;color:var(--body)}.guide-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.guide-card{display:grid;grid-template-columns:minmax(150px,210px) 1fr;gap:28px;padding:26px;border:1px solid var(--line);background:#f6f3ed}.guide-cover{display:block;width:100%;aspect-ratio:3/4;object-fit:cover}.guide-cover--graphic{display:flex;flex-direction:column;justify-content:space-between;padding:20px;color:#fff;background:#0a1931;box-shadow:10px 10px 0 #ffc107}.guide-cover--graphic small{color:#ffc107;font-size:.72rem;font-weight:900;letter-spacing:.1em}.guide-cover--graphic strong{font-size:clamp(1.7rem,3vw,2.5rem);line-height:1.1}.guide-cover--graphic span{color:#d5dfec;font-size:.8rem}.guide-copy{display:flex;flex-direction:column;align-items:flex-start}.guide-topic{margin:0;color:var(--orange-dark);font-size:.84rem;font-weight:900}.guide-copy h3{margin:12px 0;font-size:clamp(1.5rem,2.6vw,2.3rem);line-height:1.18}.guide-copy>p:not(.guide-topic){margin:0 0 24px;color:var(--body);line-height:1.7}.guide-copy a{display:inline-flex;min-height:46px;align-items:center;margin-top:auto;padding:0 18px;color:white;background:var(--ink);font-weight:900}.guide-copy a:hover,.guide-copy a:focus-visible{background:var(--orange-dark)}.guide-copy small{margin-top:10px;color:var(--body);font-size:.8rem}
  @media(max-width:950px){.guide-grid{grid-template-columns:1fr}}
  @media(max-width:620px){.hero-mark{display:none}.section-heading{align-items:flex-start;flex-direction:column}.guide-card{grid-template-columns:1fr}.guide-cover{max-width:220px}.guide-copy{padding-top:8px}}
</style>
