---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../data/categories";

const items = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout title="工程新聞｜工程白話文 BuildScope" description="香港建築新聞、政策法例、建築科技與 AI、安全消息及大型工程動向。">
  <header class="page-hero"><div class="container"><h1>工程<span>新聞</span></h1><p>聚焦香港建築新聞、政策法例、建築科技與 AI、安全消息及大型工程動向。</p></div></header>
  <section class="section"><div class="container"><div class="news-table">{items.map((item) => <article><time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time><span>{item.data.category}</span><div><h2><a href={`/news/${item.id}/`}>{item.data.title}</a></h2><p>{item.data.summary}</p></div><a href={`/news/${item.id}/`}>閱讀摘要 →</a></article>)}</div></div></section>
</BaseLayout>
<style>
  .news-table{border-top:3px solid var(--orange)}
  article{display:grid;grid-template-columns:120px 170px 1fr auto;gap:22px;align-items:start;padding:30px 18px;border-bottom:1px solid var(--line)}
  time,article>span{color:var(--orange-dark);font-size:.85rem;font-weight:800}h2{margin:0 0 8px;font-size:1.25rem}h2 a:hover{color:var(--orange-dark)}p{margin:0;color:var(--body)}article>a{color:var(--orange-dark);font-weight:800;white-space:nowrap}
  @media(max-width:760px){article{grid-template-columns:100px 1fr}article>span{grid-column:2}article>div{grid-column:1/-1}article>a{grid-column:1/-1}}
</style>
