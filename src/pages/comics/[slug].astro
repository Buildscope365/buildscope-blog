---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const comics = (await getCollection("comics", ({ data }) => !data.draft))
    .sort((a, b) => a.data.episode - b.data.episode);
  return comics.map((comic, index) => ({
    params: { slug: comic.id },
    props: { comic, previous: comics[index - 1], next: comics[index + 1] },
  }));
}
const { comic, previous, next } = Astro.props;
const { data } = comic;
const canonical = new URL(`/comics/${comic.id}/`, Astro.site).toString();
const imageUrl = new URL(data.image, Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ComicStory",
  name: data.title,
  headline: data.seoTitle,
  description: data.seoDescription,
  url: canonical,
  datePublished: data.publishedDate.toISOString().slice(0, 10),
  inLanguage: "zh-Hant-HK",
  isPartOf: { "@type": "CreativeWorkSeries", name: "工程人崩潰日常", url: "https://buildscope-blog.com/comics/" },
  image: { "@type": "ImageObject", url: imageUrl, width: data.imageWidth, height: data.imageHeight, caption: data.imageAlt },
  publisher: { "@type": "Organization", name: "BuildScope 工程白話文", url: "https://buildscope-blog.com/" },
};
---
<BaseLayout title={data.seoTitle} description={data.seoDescription} image={data.image} type="article" publishedTime={data.publishedDate.toISOString()} jsonLd={jsonLd}>
  <article class="comic-page">
    <div class="shell">
      <nav class="breadcrumb" aria-label="麵包屑"><a href="/comics/">← 返回漫畫列表</a><span>{data.series}</span></nav>
      <header class="comic-heading"><p class="eyebrow">BUILDSCOPE SITE LIFE COMICS · EPISODE {String(data.episode).padStart(2, "0")}</p><h1>{data.title}</h1><p class="category">{data.series} <span>／</span> {data.category}</p></header>
      <figure class="comic-image"><button type="button" class="zoom-trigger" aria-label="點擊放大完整漫畫" aria-haspopup="dialog"><img src={data.image} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} fetchpriority="high" /></button><figcaption>點擊圖片放大閱讀</figcaption></figure>
      <div class="share-actions"><a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${data.title} ${canonical}`)}`} target="_blank" rel="noopener noreferrer" aria-label="透過 WhatsApp 分享漫畫">WhatsApp 分享 ↗</a><button type="button" id="copy-link" data-url={canonical}>複製連結</button><span id="copy-status" role="status" aria-live="polite"></span></div>
      <div class="story"><div class="intro">{data.story.map((paragraph) => <p>{paragraph}</p>)}</div>
        <section aria-labelledby="practical-tip"><p class="eyebrow">笑完學返一招</p><h2 id="practical-tip">{data.tipTitle}</h2>{data.tipIntroduction.map((paragraph) => <p>{paragraph}</p>)}<ul>{data.tipPoints.map((point) => <li>{point}</li>)}</ul><p>{data.tipClosing}</p><p class="disclaimer">{data.disclaimer}</p></section>
      </div>
      <nav class="episode-nav" aria-label="漫畫集數導覽"><div>{previous ? <a href={`/comics/${previous.id}/`}>← 上一集<br /><strong>{previous.data.title}</strong></a> : <span>目前為第一集</span>}</div><div>{next ? <a href={`/comics/${next.id}/`}>下一集 →<br /><strong>{next.data.title}</strong></a> : <span>下一集，敬請期待</span>}</div></nav>
      <aside class="more"><p class="eyebrow">KEEP EXPLORING</p><h2>更多工程故事</h2><p>相關文章及課程內容會陸續加入。先睇其他工程圖解。</p><a href="/visual-library/">瀏覽工程圖解庫 →</a></aside>
      <p class="back-bottom"><a href="/comics/">← 返回工程人崩潰日常</a></p>
    </div>
  </article>
  <dialog id="comic-dialog" aria-label="放大閱讀完整漫畫"><button type="button" class="close-dialog" aria-label="關閉放大圖片">關閉 ×</button><img src={data.image} alt={data.imageAlt} width={data.imageWidth} height={data.imageHeight} /></dialog>
</BaseLayout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#comic-dialog");
  document.querySelector(".zoom-trigger")?.addEventListener("click", () => dialog?.showModal());
  document.querySelector(".close-dialog")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  const copy = document.querySelector<HTMLButtonElement>("#copy-link");
  const status = document.querySelector<HTMLElement>("#copy-status");
  copy?.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(copy.dataset.url ?? location.href); if (status) status.textContent = "已複製連結"; }
    catch { if (status) status.textContent = "無法自動複製，請從瀏覽器網址列複製。"; }
  });
</script>
<style>
  .comic-page{background:#0a1931;color:white;padding:22px 0 80px}.shell{width:min(calc(100% - 28px),900px);margin:auto}.breadcrumb{display:flex;justify-content:space-between;gap:16px;color:#bac9dc;font-size:.82rem}.breadcrumb a,.back-bottom a{color:#ffcd29;font-weight:800}.comic-heading{text-align:center;padding:55px 0 36px}.eyebrow{margin:0;color:#ffcd29;font-size:.77rem;font-weight:900;letter-spacing:.12em}.comic-heading h1{font-size:clamp(2.25rem,5vw,4.3rem);line-height:1.18;margin:18px 0}.category{color:#d1dff0;font-size:.9rem}.category span{color:#ffcd29;margin:0 7px}.comic-image{margin:0;background:#09172c;border:1px solid #3b5270}.zoom-trigger{display:block;width:100%;padding:0;background:none;border:0;cursor:zoom-in}.comic-image img{width:100%;height:auto;object-fit:contain}.comic-image figcaption{padding:10px;text-align:center;color:#b9c9da;font-size:.78rem}.share-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:20px 0 64px}.share-actions a,.share-actions button{display:inline-flex;align-items:center;min-height:44px;padding:8px 18px;background:#ffcd29;color:#0a1931;border:1px solid #ffcd29;font-weight:900;cursor:pointer}.share-actions button{background:transparent;color:#ffcd29}.share-actions #copy-status{color:#c9d7e8;font-size:.85rem}.story{max-width:720px;margin:auto;font-size:1.06rem;line-height:1.9}.intro{border-left:4px solid #ffcd29;padding:4px 0 4px 22px;margin-bottom:50px;font-weight:700}.story section{padding:34px;border:1px solid #385474;background:#142c4c}.story h2{font-size:clamp(1.5rem,3vw,2rem);line-height:1.3;margin:9px 0 24px}.story p{margin:0 0 16px}.story ul{padding-left:25px;color:#ffdf66;font-weight:800}.story li{margin:5px 0}.story .disclaimer{border-top:1px solid #465e7b;padding-top:19px;color:#b8c9df;font-size:.82rem;margin-top:30px}.episode-nav{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:55px}.episode-nav>div{border-top:1px solid #4b6380;padding:20px 0;color:#b7c9db}.episode-nav>div:last-child{text-align:right}.episode-nav a{color:#ffcd29}.episode-nav strong{color:white}.more{margin-top:48px;padding:34px;background:#ffcd29;color:#0a1931}.more .eyebrow{color:#604a00}.more h2{font-size:1.7rem;margin:8px 0}.more a{font-weight:900;text-decoration:underline;text-underline-offset:4px}.back-bottom{margin:40px 0 0}#comic-dialog{max-width:min(98vw,1250px);max-height:96dvh;padding:48px 12px 12px;background:#06152b;border:1px solid #ffcd29;overflow:auto}#comic-dialog::backdrop{background:rgba(0,0,0,.88)}#comic-dialog img{display:block;width:100%;height:auto;max-width:1229px}.close-dialog{position:sticky;top:0;float:right;margin-top:-42px;padding:5px 12px;border:0;background:#ffcd29;color:#0a1931;font-weight:900;cursor:pointer}.comic-page a:focus-visible,.comic-page button:focus-visible,#comic-dialog button:focus-visible{outline:3px solid white;outline-offset:3px}@media(max-width:600px){.comic-heading{padding:42px 0 26px}.comic-image{margin-inline:-14px;border-left:0;border-right:0}.share-actions{margin-bottom:46px}.story section{padding:24px}.episode-nav{gap:20px}}
</style>
