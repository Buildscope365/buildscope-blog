---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CarouselViewer from "../../components/CarouselViewer.astro";
import { getReaders } from "../../data/readers";

export async function getStaticPaths() {
  const readers = await getReaders();
  return readers.map((reader) => ({
    params: { slug: reader.slug },
    props: { reader },
  }));
}

const { reader } = Astro.props;
---

<BaseLayout
  title={`${reader.title} | BuildScope Visual Reader`}
  description={`${reader.introduction} ${reader.quickTakeaway}`}
  image={reader.slides[0].src}
  type="article"
  publishedTime={`${reader.publishedDate}T00:00:00+08:00`}
  showChrome={false}
>
  <article class="reader-page">
    <header class="reader-header">
      <a class="back-library" href="/visual-library/">← 返回工程圖解庫</a>
      <div class="reader-brand" aria-label="BuildScope">
        <span>BUILDSCOPE</span>
      </div>
      <p class="reading-room">VISUAL READER · READING ROOM</p>
      <p class="category-line">{reader.categoryLine}</p>
      <h1>{reader.title}</h1>
      <p class="introduction">{reader.introduction}</p>
    </header>

    <section class="reader-viewer" aria-label={`${reader.slides.length} 張 Carousel 圖解`}>
      <CarouselViewer slides={reader.slides} title={reader.title} />
    </section>

    <section class="reader-note" aria-labelledby="reader-note-title">
      <p id="reader-note-title">讀圖重點</p>
      <div>{reader.quickTakeaway}</div>
    </section>

    <section class="return-panel" data-reader-completion aria-labelledby="return-title">
      <p class="completion-label" data-completion-label data-slide-count={reader.slides.length}>睇完 {reader.slides.length} 張之後</p>
      <h2 id="return-title">想再行前一步？</h2>
      <p>去 Skool 睇完整 Micro Course、下載實用 Resources，或者同其他工程人繼續討論。</p>
      <div class="cta-row">
        {reader.skoolCourseUrl ? (
          <a class="primary-cta" href={reader.skoolCourseUrl} target="_blank" rel="noopener noreferrer">在 Skool 睇 Micro Course →</a>
        ) : (
          <span class="primary-cta is-disabled" aria-disabled="true" data-config-field="skoolCourseUrl" title="確認 Topic-specific Skool Course URL 後啟用">
            Micro Course 即將開放
          </span>
        )}
        {reader.skoolResourceUrl ? (
          <a class="secondary-cta" href={reader.skoolResourceUrl} target="_blank" rel="noopener noreferrer">查看 Practical Resources ↗</a>
        ) : (
          <span class="secondary-cta is-disabled" aria-disabled="true" data-config-field="skoolResourceUrl">Resources 即將開放</span>
        )}
        {reader.skoolDiscussionUrl && <a class="discussion-cta" href={reader.skoolDiscussionUrl} target="_blank" rel="noopener noreferrer">在 Skool 繼續討論：{reader.discussionQuestion} ↗</a>}
      </div>
      {(!reader.skoolCourseUrl || !reader.skoolResourceUrl) && <small>未核實嘅 Topic-specific 連結暫時唔會啟用，避免帶你去錯誤內容。</small>}
    </section>

    <footer class="reader-footer">
      <nav aria-label="Reader 快捷連結">
        <a href="/">BuildScope 首頁</a>
        <a href="/visual-library/">Visual Library</a>
        <a href="https://buildscope-dictionary.com/">工程字典 <span aria-hidden="true">↗</span></a>
        <a href="https://www.skool.com/buildscope-learning-lab-1916" target="_blank" rel="noopener noreferrer">Community <span aria-hidden="true">↗</span></a>
      </nav>
      <p><strong>Skool = Home</strong><span aria-hidden="true"> · </span>Visual Reader = Reading Room</p>
    </footer>
  </article>
</BaseLayout>

<style>
  :global(body) { background: #f4f1eb; }
  .reader-page { width: min(calc(100% - 28px), 52rem); margin-inline: auto; padding: 32px 0 46px; }
  .reader-header { max-width: 46rem; margin: 0 auto 30px; }
  .back-library { display: inline-block; margin-bottom: 25px; color: #657486; font-size: .8rem; font-weight: 800; }
  .back-library:hover { color: #c4510b; }
  .reader-brand { display: flex; align-items: baseline; gap: 10px; color: #0b1b2f; }
  .reader-brand span { color: #f97316; font-size: .8rem; font-weight: 900; letter-spacing: .13em; }
  .reading-room { margin: 38px 0 0; color: #657486; font-size: .68rem; font-weight: 900; letter-spacing: .16em; }
  .category-line { margin: 16px 0 0; color: #c4510b; font-size: .75rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin: 12px 0 16px; color: #0b1b2f; font-size: clamp(2.5rem, 9vw, 5.2rem); line-height: .98; letter-spacing: -.065em; }
  .introduction { margin: 0; color: #425367; font-size: clamp(1rem, 2.5vw, 1.18rem); font-weight: 700; }
  .reader-viewer { width: 100%; }
  .reader-note { display: grid; grid-template-columns: 8.5rem 1fr; gap: 24px; width: min(100%, 46rem); margin: 30px auto 0; padding: 24px 0; border-block: 1px solid rgba(11, 27, 47, .16); }
  .reader-note p { margin: 0; color: #c4510b; font-size: .7rem; font-weight: 900; letter-spacing: .13em; }
  .reader-note div { color: #26384c; font-size: 1rem; font-weight: 700; line-height: 1.75; }
  .return-panel { width: min(100%, 46rem); margin: 30px auto 0; padding: clamp(28px, 7vw, 46px); border-radius: 12px; color: white; background: #0b1b2f; box-shadow: 0 24px 60px rgba(8, 21, 38, .18); transition: box-shadow .25s ease, transform .25s ease; }
  .return-panel.is-complete { transform: translateY(-2px); box-shadow: 0 24px 60px rgba(249, 115, 22, .2); }
  .completion-label { margin: 0; color: #fb923c; font-size: .7rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .return-panel h2 { max-width: 16ch; margin: 14px 0; font-size: clamp(1.8rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -.045em; }
  .return-panel > p:not(.completion-label) { margin: 0; color: #d9e0e8; line-height: 1.65; }
  .cta-row { display: grid; gap: 12px; margin-top: 24px; }
  .primary-cta, .secondary-cta { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; padding: 0 18px; border-radius: 6px; text-align: center; font-size: .86rem; font-weight: 900; }
  .primary-cta { color: #0b1b2f; background: #fb923c; }
  .primary-cta.is-disabled { color: #a9b4c1; background: #23364b; cursor: not-allowed; }
  .secondary-cta { border: 1px solid #52647a; color: white; }
  .secondary-cta.is-disabled { color: #7f8fa2; cursor: not-allowed; }
  .discussion-cta { padding-top: 8px; color: #fb923c; font-size: .84rem; font-weight: 800; line-height: 1.6; }
  .discussion-cta:hover { color: white; }
  .return-panel small { display: block; margin-top: 14px; color: #a9b4c1; line-height: 1.55; }
  .reader-footer { margin-top: 28px; color: #657486; font-size: .72rem; letter-spacing: .04em; text-align: center; }
  .reader-footer nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 18px; }
  .reader-footer nav a { display: inline-flex; min-height: 38px; align-items: center; padding: 0 12px; border: 1px solid rgba(11,27,47,.18); border-radius: 999px; color: #26384c; background: rgba(255,255,255,.55); font-weight: 800; }
  .reader-footer nav a:hover { border-color: #f97316; color: #c4510b; background: white; }
  .reader-footer p { margin: 0; }
  .reader-footer strong { color: #0b1b2f; }
  @media (max-width: 560px) {
    .reader-page { padding-top: 22px; }
    .reader-header { margin-bottom: 24px; }
    .reading-room { margin-top: 28px; }
    .reader-note { grid-template-columns: 1fr; gap: 10px; }
    .return-panel { border-radius: 8px; }
  }
</style>

<script>
  document.addEventListener("reader:slidechange", (event) => {
    const detail = (event as CustomEvent<{ isComplete: boolean }>).detail;
    const panel = document.querySelector<HTMLElement>("[data-reader-completion]");
    const label = panel?.querySelector<HTMLElement>("[data-completion-label]");
    panel?.classList.toggle("is-complete", detail.isComplete);
    const slideCount = label?.dataset.slideCount ?? "全部";
    if (label) label.textContent = detail.isComplete ? `${slideCount} 張已睇完` : `睇完 ${slideCount} 張之後`;
  });
</script>
