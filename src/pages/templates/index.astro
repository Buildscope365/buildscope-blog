---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const templates = (await getCollection("templates", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
---
<BaseLayout title="工程文件範本｜工程白話文 BuildScope">
  <header class="page-hero"><div class="container"><h1>實用文件<span>範本</span></h1><p>由合約通知到地盤日報，提供可直接修改、清晰易用的工程文件框架。</p></div></header>
  <section class="section"><div class="container"><div class="notice">範本狀態、下載連結及分類均可在網站後台更新；設定為「免費」或「付費」並加入連結後，按鈕會自動啟用。</div><div class="template-list">{templates.map((item) => <article><svg viewBox="0 0 48 56" aria-hidden="true"><path d="M8 2h21l11 11v41H8zM29 2v12h11M15 24h18M15 32h18M15 40h13" fill="none" stroke="currentColor" stroke-width="2"/></svg><div><span>{item.data.category}</span><h2>{item.data.title}</h2><p>{item.data.description}</p></div><b>{item.data.fileType}<small>{item.data.access}</small></b>{item.data.downloadUrl ? <a class="template-action" href={item.data.downloadUrl} target={item.data.downloadUrl.startsWith("http") ? "_blank" : undefined} rel={item.data.downloadUrl.startsWith("http") ? "noreferrer" : undefined}>{item.data.actionLabel}</a> : <span class="template-action disabled">{item.data.actionLabel}</span>}</article>)}</div></div></section>
</BaseLayout>
<style>
  .template-list{margin-top:32px;border-top:1px solid var(--line)}article{display:grid;grid-template-columns:56px 1fr 90px auto;gap:22px;align-items:center;padding:26px 0;border-bottom:1px solid var(--line)}svg{width:46px;color:var(--orange)}article>div>span{color:var(--orange-dark);font-size:.8rem;font-weight:800}h2{margin:2px 0;font-size:1.25rem}p{margin:0;color:var(--body);font-size:.9rem}article>b{display:grid;color:var(--muted);font-size:.82rem}article>b small{margin-top:3px;color:var(--orange-dark);font-size:.68rem}.template-action{display:inline-flex;min-height:40px;align-items:center;padding:0 15px;border:1px solid var(--ink);border-radius:5px;background:white;font-size:.85rem;font-weight:800}.template-action:hover{color:var(--orange-dark);border-color:var(--orange)}.template-action.disabled{color:var(--muted);border-color:var(--line);cursor:not-allowed}
  @media(max-width:680px){article{grid-template-columns:48px 1fr}article>b,.template-action{grid-column:2;justify-self:start}}
</style>
