---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';import EnglishCard from '../../../components/en/EnglishCard.astro';import {publishedResources,crumbs} from '../../../data/english';const items=await publishedResources();
---
<EnglishLayout title="Free Construction Resources | BuildScope English" description="Free checklists and practical notes for construction professionals." jsonLd={crumbs([{name:'Home',path:'/en/'},{name:'Free Resources',path:'/en/resources/'}])}><div class="shell"><div class="page-intro"><span class="eyebrow">Practical tools</span><h1>Free Resources</h1><p>Useful notes and checklists for the project office and the site.</p></div><section class="section">{items.length?<div class="cards">{items.map(i=><EnglishCard title={i.data.title} description={i.data.description} href={`/en/resources/${i.id}/`} label={i.data.category}/>)}</div>:<div class="empty">Free English resources are in preparation.</div>}</section></div></EnglishLayout>
