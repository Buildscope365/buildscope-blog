---
import {getCollection,render} from 'astro:content';import EnglishLayout from '../../../layouts/EnglishLayout.astro';import {crumbs} from '../../../data/english';
export async function getStaticPaths(){const items=await getCollection('englishResources',({data})=>!data.draft);return items.map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;const {Content}=await render(item);const path=`/en/resources/${item.id}/`;
---
<EnglishLayout title={`${item.data.title} | BuildScope`} description={item.data.description} jsonLd={crumbs([{name:'Home',path:'/en/'},{name:'Resources',path:'/en/resources/'},{name:item.data.title,path}])}><div class="shell"><nav class="crumbs" aria-label="Breadcrumb"><a href="/en/">Home</a> / <a href="/en/resources/">Resources</a> / {item.data.title}</nav><article class="prose"><span class="eyebrow">{item.data.category}</span><h1>{item.data.title}</h1><p>{item.data.description}</p><Content/>{item.data.downloadUrl&&<p><a class="button" href={item.data.downloadUrl} download data-en-download={item.id}>Download resource</a></p>}</article></div></EnglishLayout>
