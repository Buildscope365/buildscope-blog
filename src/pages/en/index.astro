---
import EnglishLayout from '../../layouts/EnglishLayout.astro';
import EnglishCard from '../../components/en/EnglishCard.astro';
import {publishedProducts,publishedInsights,publishedResources,englishSite} from '../../data/english';
const [guides,ebooks,insights,resources]=await Promise.all([publishedProducts('pocket-guide'),publishedProducts('ebook'),publishedInsights(),publishedResources()]);
const jsonLd={'@context':'https://schema.org','@type':'WebSite',name:'BuildScope',url:`${englishSite}/en/`,inLanguage:'en-GB',description:'Construction knowledge. Made practical.'};
const newsletterEnabled=import.meta.env.PUBLIC_EN_NEWSLETTER_ENABLED==='true';
---
<EnglishLayout title="BuildScope | Construction knowledge. Made practical." description="Practical engineering insights, contract essentials and professional pocket guides for construction professionals worldwide." jsonLd={jsonLd}>
<section class="hero"><div class="shell hero-grid"><div><p class="eyebrow">Engineering / Contracts / Practice</p><h1>Construction knowledge.<br/>Made practical.</h1><p>Practical engineering insights, contract essentials and professional pocket guides for construction professionals worldwide.</p><a class="button" href="/en/pocket-library/">Explore Pocket Library</a></div><img class="hero-graphic" src="/images/en/construction-structure.webp" width="1536" height="1024" fetchpriority="high" alt="Architectural visualisation of an exposed concrete building frame and tower crane"/></div></section>
<section class="section shell" id="pocket-library"><div class="section-heading"><div><span class="eyebrow">Field-ready reading</span><h2>Pocket Library</h2><p>Focused digital guides for the questions you face on real projects.</p></div><a href="/en/pocket-library/">Explore the library</a></div>{guides.length?<div class="cards">{guides.slice(0,3).map(p=><EnglishCard title={p.data.title} description={p.data.description} href={`/en/pocket-library/${p.data.slug}/`} label={p.data.category} image={p.data.coverImage} alt={p.data.coverAlt}/>)}</div>:<div class="empty">Our pocket guides are in preparation. Browse our free engineering insights while the library takes shape.</div>}</section>
<section class="section dark"><div class="shell editorial"><img src="/images/en/architectural-grid.svg" width="900" height="700" loading="lazy" alt="Technical illustration of a structural grid"/><div><span class="eyebrow">In depth</span><h2>Professional eBooks</h2><p>Long-form practical reading on construction, contracts and commercial decisions.</p>{ebooks.length?<div class="cards">{ebooks.slice(0,1).map(p=><EnglishCard title={p.data.title} description={p.data.description} href={`/en/ebooks/${p.data.slug}/`} label={p.data.category} image={p.data.coverImage} alt={p.data.coverAlt}/>)}</div>:<p>Our eBooks are being prepared.</p>}<a class="button" href="/en/ebooks/">Browse eBooks</a></div></div></section>
<section class="section shell"><div class="section-heading"><div><span class="eyebrow">Working knowledge</span><h2>Engineering Insights</h2><p>Clear, practical explanations for the decisions behind the drawings.</p></div><a href="/en/insights/">View all insights</a></div>{insights.length?<div class="cards">{insights.slice(0,3).map(i=><EnglishCard title={i.data.title} description={i.data.description} href={`/en/insights/${i.id}/`} label={i.data.category} image={i.data.coverImage} alt={i.data.coverAlt}/>)}</div>:<div class="empty">New insights are being prepared.</div>}</section>
<section class="section" style="background:#e9ece9"><div class="shell editorial"><div><span class="eyebrow">Useful from day one</span><h2>Free Resources</h2><p>Practical checklists and reference notes to support conversations on site and in the project office.</p><a class="button" href="/en/resources/">Explore free resources</a></div><div class="resource-feature">{resources.length?resources.slice(0,1).map(r=><EnglishCard title={r.data.title} description={r.data.description} href={`/en/resources/${r.id}/`} label={r.data.category}/>):<p>Resources will appear here once published.</p>}</div></div></section>
<section class="section shell editorial"><div><span class="eyebrow">About the publication</span><h2>Built around practical questions.</h2><p>BuildScope turns complex construction topics into approachable reading. We focus on the decisions, records and conversations that make knowledge useful at work.</p><a class="button secondary" href="/en/about/">About BuildScope</a></div><img src="/images/en/architectural-grid.svg" width="900" height="700" loading="lazy" alt="Illustrated construction drawing with grid and section detail"/></section>
<section class="section dark"><div class="shell"><span class="eyebrow">Stay informed</span><h2>BuildScope newsletter</h2><p>{newsletterEnabled?'Sign up for occasional construction insights. Please confirm your email using the link we send you.':'Our newsletter is in preparation. Subscription will open when the mailing list is ready.'}</p>{newsletterEnabled?<form id="en-newsletter" style="max-width:570px;display:grid;gap:13px"><label for="en-email">Email address</label><input id="en-email" type="email" name="email" autocomplete="email" required maxlength="254" style="min-height:48px;padding:12px;font:inherit"/><label style="display:flex;gap:10px;align-items:start"><input type="checkbox" name="consent" required/> I agree to receive the BuildScope newsletter. I can unsubscribe at any time.</label><input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px"/><button class="button" type="submit">Subscribe</button><p id="en-newsletter-status" role="status" aria-live="polite"></p></form>:<span class="notice" style="color:#d3dce4">No email addresses are collected on this page yet.</span>}</div></section>
</EnglishLayout>
<script>import {trackConversionEvent} from '../../scripts/conversionTracking';const form=document.querySelector<HTMLFormElement>('#en-newsletter');form?.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;const status=document.querySelector<HTMLElement>('#en-newsletter-status');const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(!status||!button)return;button.disabled=true;status.textContent='Sending your confirmation email…';const data=new FormData(form);try{const response=await fetch('/api/en/newsletter',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:data.get('email'),consent:data.get('consent')==='on',website:data.get('website')})});if(!response.ok)throw Error('unavailable');status.textContent='Please check your inbox to confirm your subscription.';trackConversionEvent('english_newsletter_signup',{site_edition:'english'});form.reset()}catch{status.textContent='Subscription is temporarily unavailable. Please try again later.'}finally{button.disabled=false}});</script>
