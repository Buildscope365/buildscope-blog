---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';import EnglishCard from '../../../components/en/EnglishCard.astro';import {publishedProducts,crumbs} from '../../../data/english';const products=await publishedProducts('ebook');
---
<EnglishLayout title="Professional eBooks | BuildScope" description="In-depth construction, engineering and contract management eBooks." jsonLd={crumbs([{name:'Home',path:'/en/'},{name:'eBooks',path:'/en/ebooks/'}])}><div class="shell"><div class="page-intro"><span class="eyebrow">Long-form reading</span><h1>Professional eBooks</h1><p>Detailed, usable knowledge for the construction professions.</p></div><section class="section">{products.length?<div class="cards">{products.map(p=><EnglishCard title={p.data.title} description={p.data.description} href={`/en/ebooks/${p.data.slug}/`} label={p.data.category} image={p.data.coverImage} alt={p.data.coverAlt}/>)}</div>:<div class="empty"><h2>eBooks in preparation</h2><p>Our eBooks will appear here when they are ready to publish.</p><a href="/en/insights/">Read Engineering Insights</a></div>}</section></div></EnglishLayout>
