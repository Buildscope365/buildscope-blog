---
import {getCollection,render} from 'astro:content';import EnglishLayout from '../../../layouts/EnglishLayout.astro';import {crumbs,englishSite} from '../../../data/english';
export async function getStaticPaths(){const items=await getCollection('englishProducts',({data})=>data.status==='published'&&data.kind==='ebook');return items.map(item=>({params:{slug:item.data.slug},props:{item}}));}
const {item}=Astro.props;const {Content}=await render(item);const path=`/en/ebooks/${item.data.slug}/`;
const jsonLd={'@context':'https://schema.org','@type':'Book',name:item.data.title,description:item.data.description,inLanguage:'en-GB',image:item.data.coverImage?new URL(item.data.coverImage,englishSite).toString():undefined,datePublished:item.data.publicationDate?.toISOString(),url:new URL(path,englishSite).toString(),publisher:{'@type':'Organization',name:'BuildScope'},...(item.data.price!==undefined&&item.data.currency&&item.data.gumroadUrl?{offers:{'@type':'Offer',price:item.data.price,priceCurrency:item.data.currency,url:item.data.gumroadUrl}}:{})};
---
<EnglishLayout title={`${item.data.seoTitle||item.data.title} | BuildScope English`} description={item.data.seoDescription||item.data.description} image={item.data.coverImage} jsonLd={jsonLd}><div class="shell"><nav class="crumbs" aria-label="Breadcrumb"><a href="/en/">Home</a> / <a href="/en/ebooks/">eBooks</a> / {item.data.title}</nav><article class="prose"><span class="eyebrow">{item.data.category}</span><h1>{item.data.title}</h1>{item.data.coverImage&&<img src={item.data.coverImage} alt={item.data.coverAlt||`${item.data.title} cover`} width="420" loading="eager"/>}<p>{item.data.description}</p><Content/>{item.data.previewUrl&&<p><a href={item.data.previewUrl}>Read a preview</a></p>}{item.data.gumroadUrl&&<p><a class="button" href={item.data.gumroadUrl} rel="noopener noreferrer" data-en-gumroad={item.data.productId}>View on Gumroad{item.data.price!==undefined&&item.data.currency?` · ${item.data.currency} ${item.data.price}`:''}</a></p>}</article></div><script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs([{name:'Home',path:'/en/'},{name:'eBooks',path:'/en/ebooks/'},{name:item.data.title,path}])).replaceAll('<','\\u003c')}/></EnglishLayout>
