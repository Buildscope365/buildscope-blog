---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';import EnglishCard from '../../../components/en/EnglishCard.astro';import {publishedProducts,crumbs} from '../../../data/english';const products=await publishedProducts('pocket-guide');
---
<EnglishLayout title="Pocket Library | BuildScope" description="Focused digital pocket guides for construction professionals." jsonLd={crumbs([{name:'Home',path:'/en/'},{name:'Pocket Library',path:'/en/pocket-library/'}])}><div class="shell"><div class="page-intro"><span class="eyebrow">Digital field notes</span><h1>Pocket Library</h1><p>Compact guides designed to turn complex engineering and commercial topics into practical reading.</p></div><section class="section">{products.length?<div class="cards">{products.map(p=><EnglishCard title={p.data.title} description={p.data.description} href={`/en/pocket-library/${p.data.slug}/`} label={p.data.downloadUrl?`Free PDF · ${p.data.category}`:p.data.category} image={p.data.coverImage} alt={p.data.coverAlt}/>)}</div>:<div class="empty"><h2>Guides in preparation</h2><p>There are no published pocket guides yet. Explore the free insights and resources in the meantime.</p><a href="/en/insights/">Read Engineering Insights</a></div>}</section></div></EnglishLayout>
