---
import {getCollection,render} from 'astro:content';import EnglishLayout from '../../../layouts/EnglishLayout.astro';import {crumbs,englishSite} from '../../../data/english';
export async function getStaticPaths(){const items=await getCollection('englishInsights',({data})=>!data.draft);return items.map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;const {Content}=await render(item);const path=`/en/insights/${item.id}/`;const jsonLd={'@context':'https://schema.org','@type':'Article',headline:item.data.title,description:item.data.description,inLanguage:'en-GB',datePublished:item.data.date.toISOString(),author:{'@type':'Organization',name:'BuildScope'},mainEntityOfPage:new URL(path,englishSite).toString()};
---
<EnglishLayout title={`${item.data.seoTitle||item.data.title} | BuildScope`} description={item.data.description} image={item.data.coverImage} type="article" jsonLd={jsonLd}><div class="shell"><nav class="crumbs" aria-label="Breadcrumb"><a href="/en/">Home</a> / <a href="/en/insights/">Insights</a> / {item.data.title}</nav><article class="prose"><span class="eyebrow">{item.data.category}</span><h1>{item.data.title}</h1><p class="notice">Published {item.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</p><p class="lead">{item.data.description}</p><Content/></article></div><script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs([{name:'Home',path:'/en/'},{name:'Insights',path:'/en/insights/'},{name:item.data.title,path}])).replaceAll('<','\\u003c')}/></EnglishLayout>
