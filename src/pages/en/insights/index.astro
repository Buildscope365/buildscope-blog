---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';import EnglishCard from '../../../components/en/EnglishCard.astro';import {publishedInsights,crumbs} from '../../../data/english';const items=await publishedInsights();
---
<EnglishLayout title="Engineering Insights | BuildScope English" description="Practical engineering and construction knowledge, explained clearly." jsonLd={crumbs([{name:'Home',path:'/en/'},{name:'Engineering Insights',path:'/en/insights/'}])}><div class="shell"><div class="page-intro"><span class="eyebrow">Ideas for practice</span><h1>Engineering Insights</h1><p>Construction concepts, drawings and project decisions explained in plain British English.</p></div><section class="section">{items.length?<div class="cards">{items.map(i=><EnglishCard title={i.data.title} description={i.data.description} href={`/en/insights/${i.id}/`} label={i.data.category} image={i.data.coverImage} alt={i.data.coverAlt}/>)}</div>:<div class="empty">Our first English insights are in preparation.</div>}</section></div></EnglishLayout>
