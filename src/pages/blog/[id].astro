---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabel, formatDate } from "../../data/categories";
import { getReaders } from "../../data/readers";
import { buildArticleJsonLd } from "../../data/articleSeo";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content } = await render(post);
const [allPosts, readers] = await Promise.all([
  getCollection("blog", ({ data }) => !data.draft),
  getReaders(),
]);
const relatedArticles = allPosts.filter((item) => item.id !== post.id).sort((a, b) => {
  const score = (item: CollectionEntry<"blog">) => (post.data.relatedArticles.includes(item.id) ? 100 : 0) + (item.data.category === post.data.category ? 10 : 0) + item.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
  return score(b) - score(a) || b.data.date.getTime() - a.data.date.getTime();
}).filter((item) => post.data.relatedArticles.includes(item.id) || item.data.category === post.data.category || item.data.tags.some((tag) => post.data.tags.includes(tag))).slice(0, 3);
const relatedReaders = readers.filter((reader) => post.data.relatedReaders.includes(reader.slug) || reader.tags.some((tag) => post.data.tags.includes(tag))).sort((a, b) => Number(post.data.relatedReaders.includes(b.slug)) - Number(post.data.relatedReaders.includes(a.slug))).slice(0, 3);
const canonical = new URL(`/blog/${post.id}/`, Astro.site).toString();
const jsonLd = buildArticleJsonLd(post.data, canonical, Astro.site!.toString());
---
<BaseLayout title={`${post.data.seoTitle ?? post.data.title}｜工程白話文 BuildScope`} description={post.data.description} image={post.data.coverImage} type="article" publishedTime={post.data.date.toISOString()} modifiedTime={post.data.updatedDate?.toISOString()} jsonLd={jsonLd}>
  <article>
    <header class="article-hero">
      <div class="container article-head">
        <a class="back" href="/blog/">← 返回工程 Blog</a>
        <span class="category">{categoryLabel(post.data.category)}</span>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="meta"><span>{post.data.author}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{post.data.readingTime}</span><span>{post.data.difficulty}</span>{post.data.lastReviewedDate && <span>最後覆核：<time datetime={post.data.lastReviewedDate.toISOString()}>{formatDate(post.data.lastReviewedDate)}</time></span>}</div>
      </div>
    </header>
    <div class="container article-shell">
      {post.data.coverImage && <figure class="cover-figure"><img class="cover" src={post.data.coverImage} alt={post.data.coverAlt ?? post.data.title} width={post.data.coverWidth} height={post.data.coverHeight} decoding="async" fetchpriority="high" />{post.data.coverCaption && <figcaption>{post.data.coverCaption}</figcaption>}</figure>}
      <div class="article-body"><Content /></div>
      {post.data.sources.length > 0 && <section class="article-extras" aria-labelledby="sources-title"><h2 id="sources-title">參考來源</h2><ol>{post.data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} ↗</a></li>)}</ol></section>}
      {relatedReaders.length > 0 && <section class="article-extras" aria-labelledby="readers-title"><h2 id="readers-title">相關工程圖解</h2><div class="related-grid">{relatedReaders.map((reader) => <a href={`/read/${reader.slug}/`}><img src={reader.slides[0].src} alt="" loading="lazy" /><strong>{reader.title}</strong><span>閱讀圖解 →</span></a>)}</div></section>}
      {relatedArticles.length > 0 && <section class="article-extras" aria-labelledby="articles-title"><h2 id="articles-title">延伸閱讀</h2><div class="related-grid">{relatedArticles.map((item) => <a href={`/blog/${item.id}/`}><strong>{item.data.title}</strong><span>{categoryLabel(item.data.category)} · {formatDate(item.data.date)}</span></a>)}</div></section>}
      {post.data.tags.length > 0 && <footer class="tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</footer>}
      <p class="learning-link">想將概念應用到工程工作？<a href="https://www.skool.com/buildscope-learning-lab-1916" target="_blank" rel="noopener noreferrer">了解 BuildScope Learning Lab ↗</a></p>
      <a class="button" href="/blog/">返回全部文章</a>
    </div>
  </article>
</BaseLayout>
<style>
  .article-hero{padding:68px 0 58px;border-bottom:1px solid var(--line);background:var(--soft)}
  .article-head{max-width:900px}.back{display:inline-block;margin-bottom:34px;color:var(--body);font-size:.85rem;font-weight:800}.back:hover{color:var(--orange-dark)}
  .category{display:block;color:var(--orange-dark);font-size:.85rem;font-weight:900}.article-head h1{max-width:880px;margin:12px 0 20px;font-size:clamp(2.35rem,6vw,4.8rem);line-height:1.08;letter-spacing:-.055em}.article-head>p{max-width:760px;margin:0;color:var(--body);font-size:1.15rem}.meta{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:28px;color:var(--muted);font-size:.82rem}.article-shell{max-width:900px;padding-top:56px;padding-bottom:86px}.cover{width:100%;max-height:520px;margin-bottom:44px;object-fit:cover}.article-body{max-width:760px;font-size:1.05rem;line-height:1.9}.article-body :global(h2){margin:2.5em 0 .65em;font-size:1.75rem;line-height:1.35}.article-body :global(h3){margin:2em 0 .55em;font-size:1.3rem}.article-body :global(p){margin:0 0 1.35em;color:var(--body)}.article-body :global(li){margin:.45em 0;color:var(--body)}.article-body :global(blockquote){margin:2em 0;padding:18px 22px;border-left:4px solid var(--orange);background:var(--soft)}.article-body :global(blockquote p){margin:0}.tags{display:flex;flex-wrap:wrap;gap:8px;margin:44px 0 30px;padding-top:24px;border-top:1px solid var(--line)}.tags span{padding:5px 10px;border:1px solid var(--line);border-radius:4px;color:var(--body);font-size:.78rem}
  .article-body :global(img){max-width:100%;height:auto}.article-body :global(pre),.article-body :global(table){max-width:100%;overflow-x:auto}.article-body :global(a),.article-extras a,.learning-link a{color:var(--orange-dark);text-decoration:underline;text-underline-offset:3px}.article-extras{margin-top:46px;padding-top:22px;border-top:1px solid var(--line)}.article-extras h2{font-size:1.35rem}.article-extras li{margin:8px 0}.related-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,205px),1fr));gap:14px}.related-grid a{display:flex;flex-direction:column;gap:8px;padding:15px;border:1px solid var(--line);text-decoration:none}.related-grid img{width:100%;aspect-ratio:4/3;object-fit:cover}.related-grid span{font-size:.8rem}.learning-link{margin-top:36px;padding:20px;background:var(--soft)}@media(max-width:600px){.article-hero{padding:36px 0}.back{margin-bottom:22px}.article-shell{padding-top:30px}.article-body{font-size:1rem;line-height:1.8}}
  .cover-figure{margin:0 0 44px}.cover-figure .cover{margin-bottom:8px}.cover-figure figcaption,.article-body :global(figcaption){color:var(--muted);font-size:.85rem;line-height:1.6}.article-body :global(figure){margin:2em 0}.article-body :global(figure img){display:block;width:100%;height:auto}.article-body :global(figure figcaption){margin-top:8px}
</style>
