---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabel, formatDate } from "../../data/categories";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category))];
---
<BaseLayout title="工程 Blog｜工程白話文 BuildScope" description="BuildScope 工程 Blog，以白話拆解合約、施工、管理及 AI 工程應用。">
  <header class="page-hero"><div class="container"><h1>工程 <span>Blog</span></h1><p>將複雜的合約條款、施工流程及工程管理問題，整理成工程人真正用得上的內容。</p></div></header>
  <section class="section">
    <div class="container">
      <div class="filters" aria-label="文章分類">
        <button type="button" class="active" data-filter="all" aria-pressed="true">全部</button>
        {categories.map((category) => <button type="button" data-filter={category} aria-pressed="false">{categoryLabel(category)}</button>)}
      </div>
      <label class="search-label" for="article-search">搜尋文章</label>
      <input id="article-search" class="article-search" type="search" placeholder="搜尋標題、簡介或標籤" autocomplete="off" />
      <p id="article-count" class="article-count" aria-live="polite">共 {posts.length} 篇文章</p>
      {posts.length > 0 ? (
        <div class="posts">
          {posts.map((post, index) => (
            <article class="post" data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`.toLocaleLowerCase()}>
              <span class="post-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <span class="category">{categoryLabel(post.data.category)}</span>
                <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)} · {post.data.readingTime}</time>
              </div>
              <a href={`/blog/${post.id}/`} aria-label={`閱讀：${post.data.title}`}>閱讀文章 →</a>
            </article>
          ))}
        </div>
      ) : <p class="empty">暫時未有已發布文章。</p>}
      <p id="no-results" class="empty" hidden>找不到符合條件的文章，試試其他關鍵字。</p>
    </div>
  </section>
</BaseLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const posts = document.querySelectorAll<HTMLElement>("[data-category]");
  const search = document.querySelector<HTMLInputElement>("#article-search");
  const count = document.querySelector<HTMLElement>("#article-count");
  const empty = document.querySelector<HTMLElement>("#no-results");
  let active = "all";
  const update = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;
    posts.forEach((post) => {
      post.hidden = (active !== "all" && post.dataset.category !== active) || !post.dataset.search?.includes(query);
      if (!post.hidden) visible++;
    });
    if (count) count.textContent = `顯示 ${visible} 篇文章`;
    if (empty) empty.hidden = visible > 0 || posts.length === 0;
  };
  buttons.forEach((button) => button.addEventListener("click", () => {
    active = button.dataset.filter ?? "all";
    buttons.forEach((item) => item.classList.remove("active"));
    buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
    button.classList.add("active");
    update();
  }));
  search?.addEventListener("input", update);
</script>
<style>
  .filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:36px; }
  .search-label{display:block;margin-bottom:8px;font-weight:800}.article-search{display:block;width:min(100%,540px);min-height:48px;padding:9px 14px;border:1px solid var(--line);border-radius:5px;font:inherit}.article-search:focus{outline:2px solid var(--orange)}.article-count{color:var(--muted);font-size:.85rem}.post[hidden],.empty[hidden]{display:none}
  .filters button { min-height:40px; padding:0 15px; border:1px solid var(--line); border-radius:5px; color:var(--body); background:white; font-weight:700; cursor:pointer; }
  .filters button:hover,.filters button.active { color:white; border-color:var(--orange); background:var(--orange); }
  .posts { border-top:1px solid var(--line); }
  .post { display:grid; grid-template-columns:74px 1fr auto; gap:28px; align-items:start; padding:38px 0; border-bottom:1px solid var(--line); }
  .post-number { color:var(--orange); font-size:1.5rem; font-weight:800; }
  .category { color:var(--orange-dark); font-size:.82rem; font-weight:800; }
  .post h2 { margin:8px 0; font-size:clamp(1.3rem,3vw,2rem); line-height:1.3; }
  .post h2 a:hover { color:var(--orange-dark); }
  .post p { max-width:700px; margin:0; color:var(--body); }
  .post time { display:block; margin-top:14px; color:var(--muted); font-size:.8rem; }
  .post > a { margin-top:32px; color:var(--orange-dark); font-weight:800; white-space:nowrap; }
  .empty { padding:40px; background:var(--soft); text-align:center; }
  @media(max-width:640px){.post{grid-template-columns:42px 1fr}.post>a{grid-column:2;margin-top:0}.post-number{font-size:1.1rem}}
</style>
