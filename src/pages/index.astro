---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getReaders } from "../data/readers";

const readers = (await getReaders()).slice(0, 3);
const skoolUrl = "https://www.skool.com/buildscope-learning-lab-1916";
---

<BaseLayout
  title="工程白話文 BuildScope｜香港工程圖解知識庫"
  description="用工程圖解，15 分鐘睇明一個香港建築工程 Topic；再到 BuildScope Learning Lab 學習 Micro Course、Resources 及案例。"
  image={readers[0]?.slides[0]?.src}
>
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">BUILDSCOPE ENGINEERING KNOWLEDGE LIBRARY</p>
        <h1>15分鐘，<br />睇明一個<span>工程 Topic。</span></h1>
        <p>免費用圖解掌握工程概念，再到 Skool 學習 Micro Course、下載 Resources，同其他工程人交流。</p>
        <div class="hero-actions">
          <a class="primary-action" href="/visual-library/">瀏覽工程圖解 <span aria-hidden="true">→</span></a>
          <a class="secondary-action" href={skoolUrl} target="_blank" rel="noopener noreferrer">Join Community <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-points" aria-label="平台特色"><span>免費閱讀</span><span>手機滑動</span><span>實用工程 Topics</span></div>
      </div>
      <div class="home-hero-media">
        <img src={readers[0]?.slides[0]?.src ?? "/images/hero-construction.webp"} alt="BuildScope 最新工程圖解" width="1080" height="1350" />
        <div class="media-note"><strong>{readers.length}</strong><span>個精選圖解<br />持續更新</span></div>
      </div>
    </div>
  </section>

  <section class="visual-section" aria-labelledby="featured-visuals">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">VISUAL LIBRARY</p><h2 id="featured-visuals">由一張圖開始，逐張睇明。</h2></div>
        <a href="/visual-library/">查看全部圖解 <span aria-hidden="true">→</span></a>
      </div>
      <div class="reader-grid">
        {readers.map((reader) => (
          <article class="reader-card">
            <a class="reader-cover" href={`/read/${reader.slug}/`} aria-label={`閱讀圖解：${reader.title}`}>
              <img src={reader.slides[0].src} alt={`${reader.title} 圖解封面`} width="1080" height="1350" loading="lazy" />
              <span>{reader.slides.length} 張圖解</span>
            </a>
            <div class="reader-copy">
              <p>{reader.categoryLabel}</p>
              <h3><a href={`/read/${reader.slug}/`}>{reader.title}</a></h3>
              <a class="reader-link" href={`/read/${reader.slug}/`}>開始閱讀 <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="path-section">
    <div class="container path-grid">
      <div><p class="eyebrow">HOW BUILDSCOPE WORKS</p><h2>圖解先理解，Skool 再落地。</h2></div>
      <ol>
        <li><span>01</span><div><strong>揀一個 Topic</strong><p>按分類或關鍵字搜尋你想理解嘅工程題目。</p></div></li>
        <li><span>02</span><div><strong>逐張睇圖解</strong><p>用手機滑動 Carousel，快速建立基本概念。</p></div></li>
        <li><span>03</span><div><strong>去 Skool 實踐</strong><p>繼續 Micro Course、Resources、案例及會員討論。</p></div></li>
      </ol>
    </div>
  </section>

  <section class="utility-section">
    <div class="container utility-grid">
      <div><p class="eyebrow">QUICK TOOL</p><h2>遇到工程術語唔明？</h2><p>去工程白話字典快速搜尋 EOT、VO、RFI、Claim 等常見工程字眼。</p></div>
      <a href="https://buildscope-dictionary.com/">開啟工程字典 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="community-section">
    <div class="container community-inner">
      <div><p class="eyebrow">BUILDSCOPE LEARNING LAB</p><h2>由「睇明」去到「用得到」。</h2><p>加入 Skool Community，繼續 Micro Course、Resources、案例分享及工程討論。</p></div>
      <a href={skoolUrl} target="_blank" rel="noopener noreferrer">Join BuildScope Community <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow{margin:0;color:var(--orange);font-size:.74rem;font-weight:900;letter-spacing:.14em}.home-hero{overflow:hidden;padding:clamp(52px,8vw,96px) 0;background:#f6f3ed}.home-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:clamp(40px,7vw,100px)}.home-hero-copy h1{margin:20px 0 24px;font-size:clamp(3.3rem,6.5vw,6.6rem);line-height:.95;letter-spacing:-.075em}.home-hero-copy h1 span{color:var(--orange)}.home-hero-copy>p:not(.eyebrow){max-width:640px;margin:0;color:var(--body);font-size:1.12rem;line-height:1.8}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.hero-actions a{display:inline-flex;min-height:52px;align-items:center;justify-content:center;gap:16px;padding:0 20px;border:2px solid var(--ink);font-weight:900}.primary-action{color:white;background:var(--ink)}.primary-action:hover{border-color:var(--orange);background:var(--orange)}.secondary-action:hover{color:white;background:var(--ink)}.hero-points{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.hero-points span{padding:6px 10px;border:1px solid var(--line);color:var(--body);background:white;font-size:.75rem;font-weight:800}.home-hero-media{position:relative;width:min(100%,480px);justify-self:end}.home-hero-media img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;box-shadow:24px 24px 0 #0a1931}.media-note{position:absolute;right:-26px;bottom:34px;display:flex;align-items:center;gap:10px;padding:14px 18px;color:#0a1931;background:#ffc107;box-shadow:var(--shadow)}.media-note strong{font-size:2rem}.media-note span{font-size:.72rem;font-weight:900;line-height:1.3}.visual-section{padding:clamp(64px,8vw,110px) 0;background:white}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}.section-heading h2,.path-grid h2,.utility-grid h2,.community-inner h2{margin:10px 0 0;font-size:clamp(2.1rem,4.2vw,4rem);line-height:1.08;letter-spacing:-.055em}.section-heading>a{color:var(--orange-dark);font-weight:900}.reader-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.reader-card{border:1px solid var(--line);background:white;transition:transform .2s,border-color .2s}.reader-card:hover{transform:translateY(-4px);border-color:var(--orange)}.reader-cover{position:relative;display:block;overflow:hidden;aspect-ratio:4/5;background:#0a1931}.reader-cover img{width:100%;height:100%;object-fit:cover}.reader-cover>span{position:absolute;right:12px;bottom:12px;padding:6px 9px;color:#0a1931;background:#ffc107;font-size:.7rem;font-weight:900}.reader-copy{padding:22px}.reader-copy p{margin:0;color:var(--orange-dark);font-size:.72rem;font-weight:900;text-transform:uppercase}.reader-copy h3{margin:10px 0 22px;font-size:1.45rem;line-height:1.28}.reader-link{display:inline-flex;align-items:center;gap:12px;color:var(--orange-dark);font-weight:900}.path-section{padding:clamp(64px,8vw,100px) 0;color:white;background:#0a1931}.path-section .eyebrow{color:#ffc107}.path-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,8vw,110px)}.path-grid ol{display:grid;gap:0;margin:0;padding:0;list-style:none}.path-grid li{display:grid;grid-template-columns:58px 1fr;gap:20px;padding:24px 0;border-bottom:1px solid rgba(255,255,255,.16)}.path-grid li:first-child{padding-top:0}.path-grid li>span{color:#ffc107;font-family:ui-monospace,monospace;font-weight:900}.path-grid strong{font-size:1.15rem}.path-grid li p{margin:6px 0 0;color:#bdc9d9}.utility-section{padding:62px 0;background:#f6f3ed}.utility-grid{display:grid;grid-template-columns:1fr auto;align-items:center;gap:40px}.utility-grid>div>p:last-child{max-width:660px;margin:18px 0 0;color:var(--body)}.utility-grid>a{display:inline-flex;min-height:52px;align-items:center;gap:16px;padding:0 20px;color:white;background:var(--ink);font-weight:900}.community-section{padding:70px 0;color:#0a1931;background:#ffc107}.community-section .eyebrow{color:#6f5500}.community-inner{display:grid;grid-template-columns:1fr auto;align-items:center;gap:50px}.community-inner p:last-child{max-width:680px;margin:18px 0 0}.community-inner>a{display:inline-flex;min-height:54px;align-items:center;gap:16px;padding:0 22px;border:2px solid #0a1931;font-weight:900}.community-inner>a:hover{color:#ffc107;background:#0a1931}
  @media(max-width:900px){.home-hero-grid,.path-grid{grid-template-columns:1fr}.home-hero-media{width:min(82%,480px);justify-self:center;order:-1}.reader-grid{grid-template-columns:repeat(2,1fr)}.community-inner{grid-template-columns:1fr}.community-inner>a{justify-self:start}}
  @media(max-width:620px){.home-hero{padding-top:38px}.home-hero-media{width:calc(100% - 28px)}.home-hero-media img{box-shadow:14px 14px 0 #0a1931}.media-note{right:-14px;bottom:20px}.home-hero-copy h1{font-size:clamp(3rem,14vw,4.5rem)}.hero-actions a{width:100%}.section-heading{align-items:flex-start;flex-direction:column}.reader-grid{grid-template-columns:1fr}.utility-grid{grid-template-columns:1fr}.utility-grid>a{justify-self:start}.community-inner>a{width:100%;justify-content:center}}
  @media(prefers-reduced-motion:reduce){.reader-card{transition:none}}
</style>
