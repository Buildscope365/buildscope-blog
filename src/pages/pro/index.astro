---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getReaders } from "../../data/readers";

const skoolPlansUrl = "https://www.skool.com/buildscope-learning-lab-1916/plans";
const visualLibraryUrl = "/visual-library/";
const readers = await getReaders();
const verifiedCourses = readers.filter((reader) => reader.isProCourseAvailable && reader.skoolCourseUrl);
const verifiedResources = readers.filter((reader) => reader.isProCourseAvailable && reader.skoolResourceUrl && reader.resourceTitle);
---

<BaseLayout
  title="BuildScope PRO Membership｜香港建築人的實務知識庫"
  description="了解 BuildScope PRO：Micro Courses、Excel Templates、PDF Resources、Practical Checklists 及工程案例。會籍登記及付款由 Skool 處理。"
  image={verifiedCourses[0]?.slides[0]?.src}
>
  <div class="pro-page">
    <section class="pro-hero">
      <div class="pro-shell hero-grid">
        <div class="hero-copy">
          <p class="section-label">BUILDSCOPE PRO MEMBERSHIP</p>
          <h1>香港建築人的<br /><span>實務知識庫</span></h1>
          <p>由地盤施工、工程管理、合約 QS，到屋宇設備及 AI 應用。一個會籍，持續學習工程知識。</p>
          <div class="hero-pricing"><strong>US$8/月</strong><span>或</span><strong>US$64/年</strong></div>
          <div class="hero-actions">
            <a
              class="primary-button"
              href={skoolPlansUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-event="pro_upgrade_click"
              data-cta-location="pro_hero"
              data-destination-type="skool_membership_information"
            >查看 FREE / PRO 會籍方案 →</a>
            <a class="secondary-button" href={visualLibraryUrl}>先免費探索工程圖解庫</a>
          </div>
          <small>會籍登記、付款及內容存取均由 Skool 處理；BuildScope 網站不處理付款。</small>
        </div>
        <div class="hero-panel" aria-label="BuildScope PRO 內容範圍">
          <p>PRO MEMBERSHIP</p>
          <ul>
            <li><span>01</span>完整 Micro Courses</li>
            <li><span>02</span>Excel Templates</li>
            <li><span>03</span>PDF Resources</li>
            <li><span>04</span>Practical Checklists</li>
            <li><span>05</span>Case Studies</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="comparison-section" aria-labelledby="comparison-title">
      <div class="pro-shell">
        <div class="section-heading">
          <p class="section-label">FREE OR PRO</p>
          <h2 id="comparison-title">先免費睇明，再按需要深入應用。</h2>
        </div>
        <div class="comparison-grid">
          <article class="plan free-plan">
            <p>FREE</p>
            <h3>建立基本概念</h3>
            <ul>
              <li>免費 Visual Library</li>
              <li>Skool Community</li>
              <li>兩個免費入門課程</li>
            </ul>
            <a href={visualLibraryUrl}>開始免費閱讀 →</a>
          </article>
          <article class="plan pro-plan">
            <p>PRO</p>
            <h3>由理解去到實務應用</h3>
            <ul>
              <li>PRO Micro Courses</li>
              <li>Excel Templates、PDF Resources</li>
              <li>Practical Checklists、Case Studies</li>
            </ul>
            <a href="#pricing">查看會籍選項 →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="courses-section" aria-labelledby="courses-title">
      <div class="pro-shell">
        <div class="section-heading split-heading">
          <div><p class="section-label">VERIFIED MICRO COURSES</p><h2 id="courses-title">由圖解延伸到完整學習。</h2></div>
          <p>以下只列出網站已有核實 Skool Classroom URL 的課程。</p>
        </div>
        <div class="course-list">
          {verifiedCourses.map((course) => (
            <article class="course-row">
              <img src={course.slides[0].src} alt={`${course.courseTitle ?? course.title} 圖解封面`} width="1080" height="1350" loading="lazy" />
              <div>
                <p>{course.categoryLabel}</p>
                <h3>{course.courseTitle ?? course.title}</h3>
                <span>{course.introduction}</span>
                <a
                  href={course.skoolCourseUrl!}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-event="skool_cta_click"
                  data-cta-location="pro_verified_courses"
                  data-destination-type="skool_course"
                  data-content-id={course.slug}
                  data-content-title={course.title}
                  data-content-category={course.category}
                >前往已核實 Skool Classroom ↗</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="resources-section" aria-labelledby="resources-title">
      <div class="pro-shell resource-layout">
        <div class="section-heading">
          <p class="section-label">PRACTICAL RESOURCES</p>
          <h2 id="resources-title">唔只係睇，仲要用得到。</h2>
          <p>PRO 內容包括實務工具類型；實際上架項目及內容以 Skool Classroom 顯示為準。</p>
        </div>
        <div class="resource-types" aria-label="PRO Resources 類型">
          <div><span>01</span><strong>Excel Templates</strong><small>協助整理、記錄及跟進工程資料。</small></div>
          <div><span>02</span><strong>PDF Resources</strong><small>快速重溫工程 Topic 及實務重點。</small></div>
          <div><span>03</span><strong>Practical Checklists</strong><small>將學習內容轉成可以跟住做嘅工作提示。</small></div>
        </div>
      </div>
      {verifiedResources.map((resource) => (
        <div class="pro-shell verified-resource">
          <div><p>VERIFIED HVAC RESOURCE</p><h3>{resource.resourceTitle}</h3><span>{resource.resourcePreview}</span></div>
          <a
            href={resource.skoolResourceUrl!}
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="skool_cta_click"
            data-cta-location="pro_verified_resources"
            data-destination-type="skool_resource"
            data-content-id={resource.slug}
            data-content-title={resource.title}
            data-content-category={resource.category}
          >已是會員？前往 Skool 查看 ↗</a>
        </div>
      ))}
    </section>

    <section class="pricing-section" id="pricing" aria-labelledby="pricing-title">
      <div class="pro-shell pricing-grid">
        <div>
          <p class="section-label">MEMBERSHIP</p>
          <h2 id="pricing-title">揀適合你嘅會籍周期。</h2>
          <p>所有實際登記、付款、續訂及會籍管理均在 Skool 完成。</p>
        </div>
        <div class="price-options">
          <div><p>MONTHLY</p><strong>US$8</strong><span>/ 月</span></div>
          <div><p>ANNUAL</p><strong>US$64</strong><span>/ 年</span></div>
          <a
            href={skoolPlansUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="pro_upgrade_click"
            data-cta-location="pro_pricing"
            data-destination-type="skool_membership_information"
          >查看 FREE / PRO 會籍方案 →</a>
        </div>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <div class="pro-shell faq-layout">
        <div><p class="section-label">FAQ</p><h2 id="faq-title">加入前常見問題</h2></div>
        <div class="faq-list">
          <details open><summary>免費內容包括甚麼？</summary><p>你可以免費使用 Visual Library、加入 Skool Community，並瀏覽指定免費入門課程。</p></details>
          <details><summary>PRO 主要提供甚麼？</summary><p>PRO 主要提供更多 Micro Courses，以及 Excel Templates、PDF Resources、Practical Checklists 同 Case Studies。</p></details>
          <details><summary>可唔可以直接在 BuildScope 網站付款？</summary><p>不可以。BuildScope 網站只提供課程及會籍資訊；實際登記、付款及內容存取由 Skool 處理。</p></details>
          <details><summary>點樣確認某個 Topic 有完整課程？</summary><p>只有已核實 Skool Classroom URL 的 Topic，先會顯示直接前往 Classroom 的連結。</p></details>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="pro-shell final-cta-inner">
        <div><h2>準備由「睇明」行到「用得到」？</h2><p>先在 Skool 查看會籍資訊，或者繼續免費探索工程圖解。</p></div>
        <div>
          <a
            href={skoolPlansUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="pro_upgrade_click"
            data-cta-location="pro_final_cta"
            data-destination-type="skool_membership_information"
          >查看 FREE / PRO 會籍方案 →</a>
          <a href={visualLibraryUrl}>返回免費 Visual Library</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pro-page { --navy: #0a1931; --navy-soft: #142a49; --yellow: #ffc107; --cream: #f6f3ed; color: #111; }
  .pro-shell { width: min(calc(100% - 40px), 1180px); margin-inline: auto; }
  .section-label { margin: 0; color: #b34b0c; font-size: .72rem; font-weight: 900; letter-spacing: .15em; }
  .pro-hero { padding: clamp(60px, 9vw, 112px) 0; color: white; background: var(--navy); background-image: linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px); background-size: 44px 44px; }
  .pro-hero .section-label, .courses-section .section-label, .pricing-section .section-label { color: var(--yellow); }
  .hero-grid { display: grid; grid-template-columns: 1.08fr .72fr; align-items: center; gap: clamp(50px, 9vw, 120px); }
  .hero-copy h1 { max-width: 10ch; margin: 18px 0 25px; font-size: clamp(3.4rem, 7.5vw, 7rem); line-height: .94; letter-spacing: -.075em; }
  .hero-copy h1 span { color: var(--yellow); }
  .hero-copy > p:not(.section-label) { max-width: 650px; margin: 0; color: #d4deeb; font-size: 1.12rem; line-height: 1.85; }
  .hero-pricing { display: flex; align-items: baseline; gap: 12px; margin-top: 28px; }
  .hero-pricing strong { color: var(--yellow); font-size: 1.5rem; }
  .hero-pricing span { color: #93a3b6; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero-actions a { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; padding: 0 20px; font-weight: 900; }
  .primary-button { color: var(--navy); background: var(--yellow); }
  .secondary-button { border: 1px solid #6e8198; color: white; }
  .hero-copy small { display: block; max-width: 650px; margin-top: 16px; color: #93a3b6; line-height: 1.55; }
  .hero-panel { padding: 34px; border: 1px solid rgba(255,255,255,.18); background: rgba(20,42,73,.9); box-shadow: 18px 18px 0 rgba(255,193,7,.12); }
  .hero-panel > p { margin: 0 0 20px; color: var(--yellow); font-size: .68rem; font-weight: 900; letter-spacing: .15em; }
  .hero-panel ul { margin: 0; padding: 0; list-style: none; }
  .hero-panel li { display: grid; grid-template-columns: 42px 1fr; gap: 14px; padding: 15px 0; border-bottom: 1px solid rgba(255,255,255,.13); font-weight: 800; }
  .hero-panel li:last-child { border-bottom: 0; }
  .hero-panel li span { color: var(--yellow); font-family: ui-monospace, monospace; }
  .comparison-section, .resources-section, .faq-section { padding: clamp(70px, 9vw, 110px) 0; background: white; }
  .section-heading h2, .pricing-grid h2, .faq-layout h2, .final-cta h2 { max-width: 760px; margin: 12px 0 0; font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 1.04; letter-spacing: -.06em; }
  .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 42px; border: 1px solid #d9dee5; }
  .plan { min-height: 350px; padding: clamp(28px, 5vw, 52px); }
  .plan + .plan { border-left: 1px solid #d9dee5; }
  .plan > p { margin: 0; color: #b34b0c; font-size: .7rem; font-weight: 900; letter-spacing: .14em; }
  .plan h3 { margin: 15px 0 24px; font-size: 1.8rem; }
  .plan ul { display: grid; gap: 12px; margin: 0 0 34px; padding: 0; list-style: none; color: #425367; }
  .plan li::before { content: "✓"; margin-right: 10px; color: #c4510b; font-weight: 900; }
  .plan a { color: #b34b0c; font-weight: 900; }
  .pro-plan { color: white; background: var(--navy); }
  .pro-plan > p, .pro-plan a { color: var(--yellow); }
  .pro-plan ul { color: #d4deeb; }
  .pro-plan li::before { color: var(--yellow); }
  .courses-section { padding: clamp(70px, 9vw, 110px) 0; color: white; background: var(--navy); }
  .split-heading { display: grid; grid-template-columns: 1fr 340px; align-items: end; gap: 55px; }
  .split-heading > p { margin: 0; color: #aebbd0; line-height: 1.7; }
  .course-list { margin-top: 45px; }
  .course-row { display: grid; grid-template-columns: minmax(230px, 340px) 1fr; border: 1px solid rgba(255,255,255,.17); background: var(--navy-soft); }
  .course-row img { width: 100%; height: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .course-row > div { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(30px, 6vw, 70px); }
  .course-row p { margin: 0; color: var(--yellow); font-size: .7rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  .course-row h3 { margin: 15px 0; font-size: clamp(2.3rem, 5vw, 4.5rem); line-height: 1.05; }
  .course-row span { max-width: 650px; color: #c9d4e3; line-height: 1.8; }
  .course-row a { margin-top: 28px; color: var(--yellow); font-weight: 900; }
  .resource-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(50px, 9vw, 110px); }
  .resources-section .section-heading { display: block; min-width: 0; margin-bottom: 0; }
  .resources-section .section-heading > p:last-child { max-width: 560px; margin: 22px 0 0; color: #52647a; }
  .resource-types { border-top: 1px solid #d9dee5; }
  .resource-types > div { display: grid; grid-template-columns: 44px 190px 1fr; gap: 20px; padding: 25px 0; border-bottom: 1px solid #d9dee5; }
  .resource-types span { color: #c4510b; font-family: ui-monospace, monospace; font-weight: 900; }
  .resource-types small { color: #52647a; line-height: 1.6; }
  .verified-resource { display: flex; align-items: center; justify-content: space-between; gap: 35px; margin-top: 54px; padding: 28px 32px; color: white; background: var(--navy); }
  .verified-resource p { margin: 0 0 5px; color: var(--yellow); font-size: .65rem; font-weight: 900; letter-spacing: .13em; }
  .verified-resource h3 { margin: 0 0 4px; font-size: 1.35rem; }
  .verified-resource span { color: #aebbd0; }
  .verified-resource a { flex: 0 0 auto; color: var(--yellow); font-weight: 900; }
  .pricing-section { padding: clamp(70px, 9vw, 110px) 0; color: white; background: var(--navy); }
  .pricing-grid { display: grid; grid-template-columns: 1fr .9fr; align-items: center; gap: clamp(50px, 9vw, 110px); }
  .pricing-grid > div:first-child > p:last-child { max-width: 600px; color: #aebbd0; }
  .price-options { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid rgba(255,255,255,.18); }
  .price-options > div { padding: 25px; }
  .price-options > div + div { border-left: 1px solid rgba(255,255,255,.18); }
  .price-options p { margin: 0 0 8px; color: var(--yellow); font-size: .68rem; font-weight: 900; letter-spacing: .13em; }
  .price-options strong { font-size: 2.5rem; }
  .price-options span { color: #aebbd0; }
  .price-options > a { grid-column: 1 / -1; padding: 17px 22px; color: var(--navy); background: var(--yellow); text-align: center; font-weight: 900; }
  .faq-layout { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(50px, 9vw, 110px); }
  .faq-list { border-top: 1px solid #d9dee5; }
  details { border-bottom: 1px solid #d9dee5; }
  summary { padding: 21px 34px 21px 0; cursor: pointer; font-weight: 900; }
  details p { max-width: 700px; margin: -4px 0 23px; color: #52647a; line-height: 1.8; }
  .final-cta { padding: 75px 0; color: var(--navy); background: var(--yellow); }
  .final-cta-inner { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 50px; }
  .final-cta h2 { max-width: 700px; }
  .final-cta p { margin: 15px 0 0; }
  .final-cta-inner > div:last-child { display: grid; gap: 10px; }
  .final-cta a { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; padding: 0 19px; border: 2px solid var(--navy); font-weight: 900; }
  .final-cta a:first-child { color: white; background: var(--navy); }
  @media (max-width: 850px) {
    .hero-grid, .resource-layout, .pricing-grid, .faq-layout, .split-heading, .final-cta-inner { grid-template-columns: 1fr; }
    .hero-panel { box-shadow: none; }
    .split-heading { gap: 20px; }
    .verified-resource { align-items: flex-start; flex-direction: column; }
    .final-cta-inner > div:last-child { width: 100%; }
  }
  @media (max-width: 620px) {
    .pro-shell { width: min(calc(100% - 28px), 1180px); }
    .hero-copy h1 { font-size: clamp(3.2rem, 15vw, 4.7rem); }
    .hero-actions a { width: 100%; }
    .hero-pricing { flex-wrap: wrap; }
    .comparison-grid, .course-row { grid-template-columns: 1fr; }
    .plan + .plan { border-top: 1px solid #d9dee5; border-left: 0; }
    .course-row img { max-height: 520px; }
    .resource-types > div { grid-template-columns: 35px 1fr; }
    .resource-types small { grid-column: 2; }
    .verified-resource { margin-top: 38px; padding: 24px; }
    .price-options { grid-template-columns: 1fr; }
    .price-options > div + div { border-top: 1px solid rgba(255,255,255,.18); border-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pro-page * { scroll-behavior: auto !important; }
  }
</style>

<script>
  import { trackConversionEvent, type ConversionEventName } from "../../scripts/conversionTracking";

  trackConversionEvent("pro_page_view", { cta_location: "pro_page" });

  document.querySelectorAll<HTMLAnchorElement>("[data-track-event]").forEach((link) => {
    link.addEventListener("click", () => {
      trackConversionEvent(link.dataset.trackEvent as ConversionEventName, {
        content_id: link.dataset.contentId,
        content_title: link.dataset.contentTitle,
        content_category: link.dataset.contentCategory,
        cta_location: link.dataset.ctaLocation,
        destination_type: link.dataset.destinationType,
      });
    });
  });
</script>
