SITE_URL=https://buildscope-blog.com

# Instagram publishing via Meta Instagram Graph API.
# Store real values as Cloudflare secrets, not in GitHub.
IG_USER_ID=your_instagram_business_or_creator_user_id
IG_GRAPH_VERSION=v24.0
IG_ACCESS_TOKEN=store_with_wrangler_secret
IG_POST_ADMIN_TOKEN=store_with_wrangler_secret

# Public GA4 stream identifier. Keep blank to disable Google Analytics.
PUBLIC_GA4_MEASUREMENT_ID=

# Safe default: analytics waits for explicit consent.
PUBLIC_GA4_CONSENT_REQUIRED=true

# Enable only during a controlled GA4 DebugView test build.
PUBLIC_GA4_DEBUG_MODE=false
